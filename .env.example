# ============ HastRekha — every environment variable the app reads ============
# NAMES ONLY. Never commit a value to this file.
#   · on a machine: copy to .env.local (git-ignored) and fill in dev values
#   · on Vercel: Project → Settings → Environment Variables, per scope
# test/deploy-gate.test.ts fails if the app reads a name that is not listed
# here, or if a value appears. NODE_ENV is set by Next itself and is not listed.

# ---- The server contract — validated at import by lib/env.ts ----
# A missing or contradictory value throws, so a misconfigured deploy fails its
# build instead of serving a request. See SETUP.md §0 for the dev/live model.

# dev | live — decides the money path (and which keys the checks below demand)
APP_ENV=
# The site's own origin: Google sign-in's redirect URI is built from it
NEXT_PUBLIC_APP_URL=
# Neon — the dev branch for everything but live; live must point at main
DATABASE_URL=

# Auth — JWT_SECRET is at least 32 characters
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay — dev must be rzp_test_, live must be rzp_live_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# "true" lets dev exercise the money routes without Razorpay; forbidden in live
ALLOW_FAKE_MONEY=

# AI — OPENROUTER_MODEL is optional (defaults to anthropic/claude-haiku-4.5)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Email — required in live, optional in dev
RESEND_API_KEY=

# Required by lib/env.ts, for the nightly cron vercel.json schedules
# (/api/cron/rule-stats — the route is not built yet)
CRON_SECRET=

# ---- Build-time flags — inlined or read at `next build`; changing one needs a rebuild ----

# "1" opens /sanctuary, /scan/chamber and /read/pothi and redirects / to
# /sanctuary. Unset, those routes are a baked 404 and / is the original home.
NEXT_PUBLIC_SANCTUARY=
# "1" lifts /dev/rekha-monitor's development gate for scripts/capture/.
# Measurement harness only — never set it on a deploy.
SNC_MEASURE=

# ---- The build stamp — DERIVED by next.config.ts at `next build`; never set by hand ----

# Vercel sets this on its own builder for a Git-integration deploy; next.config.ts
# takes it first (when non-empty) for the stamp. Nowhere else is it set.
VERCEL_GIT_COMMIT_SHA=
# The commit the build was made from: VERCEL_GIT_COMMIT_SHA, else this name
# given to the build (the D1.5 GitHub Actions job passes the pushed commit's
# first seven characters with `vercel deploy --build-env`), else
# `git rev-parse --short HEAD`, else the export-subst .git-archive-sha, else
# "unknown". Inlined into every bundle; read by the footers and /api/version.
NEXT_PUBLIC_BUILD_SHA=
# ISO 8601, the moment the build evaluated its config. Inlined beside the SHA.
NEXT_PUBLIC_BUILT_AT=
