# ============ HastRekha environment contract (see lib/env.ts) ============
# Two real files exist locally and are git-ignored:
#   .env.local            → APP_ENV=dev   (your machine + Vercel Preview)
#   never keep live keys on your laptop; live values live ONLY in Vercel → Production
APP_ENV=dev                          # dev | live
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=dev              # mirrored for the UI badge ("DEV" ribbon)

# Neon — two branches: main (live) and dev (everything else)
DATABASE_URL=postgresql://user:pass@ep-xxxx-dev.ap-southeast-1.aws.neon.tech/hastrekha?sslmode=require

# Auth
JWT_SECRET=change-me-32-chars-minimum-please-really
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay — dev MUST be rzp_test_, live MUST be rzp_live_ (enforced at boot)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_FAKE_MONEY=true                # dev only; ignored/forbidden in live

# AI
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Email (required in live)
RESEND_API_KEY=

# Cron auth
CRON_SECRET=change-me-too
